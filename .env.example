# Environment for docker-compose.yml. Copy to .env (git-ignored) and change the passwords.
# The values below match backend/src/main/resources/application-local.yml so a backend started
# with `./mvnw spring-boot:run` connects to these containers with no extra configuration.

# --- PostgreSQL ---
POSTGRES_DB=bos
POSTGRES_USER=bos
POSTGRES_PASSWORD=bos_local_dev
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PASSWORD=bos_redis_local_dev
REDIS_PORT=6379

# --- Object storage (Cloudinary) ---
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME="dcdv6yqq7"
CLOUDINARY_API_KEY="651938872788576"
CLOUDINARY_API_SECRET="Y7J2SoO9J2z7o4ylEY0bMDLtxwI"
CLOUDINARY_FOLDER="instagram-news"

# --- Full stack (`docker compose --profile app up`) ---
# Port Nginx is published on.
WEB_PORT=8088
# Spring profile for the backend container: prod = JSON logs, API docs off.
SPRING_PROFILES_ACTIVE=prod
# Set to true to expose /swagger-ui.html and /v3/api-docs through Nginx.
API_DOCS_ENABLED=false
# Only needed if a browser origin other than Nginx itself calls the API. Comma-separated.
CORS_ALLOWED_ORIGINS=

# --- Authentication (backend container) ---
# Signing key for access tokens: at least 32 random characters. Generate one, e.g. `openssl rand -base64 48`.
# Changing it signs everyone out. The value below is a placeholder and must be replaced.
JWT_SECRET=replace-me-with-at-least-32-random-characters
# The refresh cookie is sent over HTTPS only. Set to false ONLY when serving over plain http (local Docker).
AUTH_COOKIE_SECURE=false
# First administrator, created at start-up only while the database has no users at all.
# Sign in, change the password, then remove these two lines.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# --- AI Assistant (Ask PAWAN) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# --- Email Integration (SendGrid) ---
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@pawanputra.com
SENDGRID_FROM_NAME="Pawan Putra Business OS"

# --- WhatsApp Messaging (Twilio / Meta Cloud API) ---
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_access_token
